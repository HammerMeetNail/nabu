{
  "id": "/?source=pwa",
  "name": "Nabu — Household Chore Tracker",
  "short_name": "Nabu",
  "description": "Track baby care and household chores together — fast logging, reminders, and shared stats for your household.",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4EFE7",
  "theme_color": "#19323C",
  "shortcuts": [
    {
      "name": "Log feed",
      "short_name": "Feed",
      "description": "Open the log sheet for Feed Baby, or your first feeding activity",
