    },
    {
      "name": "Log chore",
      "short_name": "Chore",
      "description": "Jump to the home grid to log a chore",
      "url": "/?quicklog=chore",
      "icons": [{ "src": "/static/icons/shortcut-log-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Activity",
      "short_name": "Activity",
      "description": "View recent activity history",
      "url": "/?quicklog=activity",
      "icons": [{ "src": "/static/icons/shortcut-activity-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
