// Settings every target and configuration shares. Debug.xcconfig and
// Release.xcconfig include this file; the project's Debug and Release
// configurations are based on them.

// The version people see in the App Store. Raise it for each release.
MARKETING_VERSION = 1.0.0
// The build number, which must grow with every upload to App Store Connect.
// An archive passes its own, e.g. xcodebuild archive CURRENT_PROJECT_VERSION=42.
// Every target reads both from here: an extension's version must match the
// app's.
CURRENT_PROJECT_VERSION = 1

// The server the app talks to. ("//" starts a comment here, hence "$()".)
NABU_BASE_URL = https:/$()/nabu-app.com
