# Prepared configuration only. Never apply to an existing cluster until its
# major version, UID, data path and rollback plan have been checked.
services:
  postgres:
    image: ${NABU_RECOVERY_POSTGRES_IMAGE:?set the tested immutable image digest}
    container_name: nabu_postgres_1
    restart: unless-stopped
    environment:
      POSTGRES_USER: nabu
      POSTGRES_DB: nabu
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres-password
    volumes:
      - ${NABU_POSTGRES_DATA:?confirm the existing data path}:/var/lib/postgresql/data
      - /etc/nabu/pgbackrest.conf:/etc/pgbackrest/pgbackrest.conf:ro
      - /etc/nabu/postgres-password:/run/secrets/postgres-password:ro
    command:
      - postgres
      - -c
      - wal_level=replica
      - -c
      - archive_mode=on
      - -c
      - archive_timeout=60s
      - -c
      - archive_command=/usr/local/bin/nabu-pgbackrest-archive-wal %p
    healthcheck:
      test: [CMD-SHELL, "pg_isready -U nabu -d nabu"]
      interval: 10s
      timeout: 3s
      retries: 3
    networks: [nabu_default]
networks:
  nabu_default:
    external: true
