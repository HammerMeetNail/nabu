# Install as /etc/nabu/recovery.env, owner deploy, mode 0600. This is trusted
# shell configuration, separate from the deploy-managed application .env.
# Fill only after inventorying the actual PostgreSQL cluster and testing images.
RECOVERY_POSTGRES_CONTAINER=nabu_postgres_1
RECOVERY_POSTGRES_IMAGE=quay.io/REPLACE/nabu-postgres@sha256:REPLACE
RECOVERY_APP_IMAGE=quay.io/nabu/nabu@sha256:REPLACE
RECOVERY_BACKUP_REMOTE=r2-nabu:nabu-app-backups
RECOVERY_KEY_FILE=/etc/nabu/logical-backup-key
RECOVERY_STATUS_DIR=/opt/nabu/state
RCLONE_CONFIG=/home/deploy/.config/rclone/rclone-nabu.conf
# Receiver must page on status=failed and alert on >5 minutes without a POST.
# Keep this capability URL private. Tests use a loopback receiver only.
RECOVERY_HEARTBEAT_URL=https://REPLACE_WITH_MONITOR_ENDPOINT
