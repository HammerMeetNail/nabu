# Nabu Environment Variables
# Copy to .env and fill in values

# Server
PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080
SERVER_SECURE=false

# PostgreSQL
DATABASE_URL=postgres://nabu:nabu@localhost:5432/nabu?sslmode=disable
# Keep the default pool until query/HTTP load measurements justify a change.
# The reminder leader lock uses one connection.
# Total per process: 8 reserved for bounded background delivery, 17 HTTP by default.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# SMTP Email (uses Resend SMTP relay)
SMTP_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (native iOS). Comma-separated audiences accepted on
# identity tokens: the iOS app's bundle ID and, if the web flow is added
# later, the Services ID. Empty disables POST /api/auth/apple/native.
APPLE_CLIENT_IDS=

# Trusted proxy CIDRs (comma-separated).
# REQUIRED in production behind a reverse proxy / Cloudflare Tunnel: without it,
# every request appears to come from the proxy IP, so per-client rate limiting
# collapses into one shared bucket and audit-log client IPs are meaningless.
# Set to your proxy/tunnel CIDR ranges (e.g. Cloudflare's published ranges, or
# the tunnel/loopback address). Production refuses to start if this is empty.
# Malformed entries and universal trust (0.0.0.0/0 or ::/0) are rejected.
# Production also requires HTTPS APP_BASE_URL and SERVER_SECURE=true.
TRUSTED_PROXY_CIDRS=

# Rate limiting (requests per minute, per client IP, per server replica)
# Each scope has one aggregate allowance; resource paths do not reset it.
# RATE_LIMIT_AUTH_MAX: strict limit on /api/auth/* (default 5)
# RATE_LIMIT_GLOBAL_MAX: permissive backstop across all /api/* routes (default
#   120). The global backstop is ONLY active when TRUSTED_PROXY_CIDRS is set,
#   so that per-client IPs are reliably attributable; otherwise it would key
#   every request to the proxy's single IP and could rate-limit all users at
#   once. Behind a proxy/tunnel, set TRUSTED_PROXY_CIDRS to enable it.
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_JOIN_MAX=10
# Per limiter: reject new clients at capacity until an existing window expires.
# Existing clients retain their remaining allowance.
RATE_LIMIT_MAX_CLIENTS=4096

# APNs (native iOS push). All four must be set to enable the sender; unset
# leaves APNs a graceful no-op (like the VAPID keys). APNS_AUTH_KEY_P8 is the
# contents of the .p8 auth key from the Apple developer portal - literal PEM,
# PEM with \n-escaped newlines, or base64 of the PEM all work.
# APNS_TEAM_ID + APNS_BUNDLE_ID alone (without the key) also enable serving
# /.well-known/apple-app-site-association for iOS universal links.
APNS_AUTH_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# Backup (Cloudflare R2)
R2_BUCKET=nabu-app-backups
BACKUP_ENCRYPTION_KEY=
BACKUP_NOTIFY_EMAILS=
BACKUP_NOTIFY_SUCCESS=1
BACKUP_NOTIFY_VERIFY_SUCCESS=0
